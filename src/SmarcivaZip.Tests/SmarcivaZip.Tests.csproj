<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SmarcivaZip.Core/SmarcivaZip.Core.csproj" />
  </ItemGroup>
  <!--
    RAR は作成できない（unRAR ライセンス）ので、テスト用の書庫はコミットしておく。
    WinRAR で作った本物の RAR5 で、日本語と韓国語のファイル名を含む。
  -->
  <ItemGroup>
    <Content Include="Fixtures/*.rar" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/*.lzh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 分類ごとにアイコンが揃っているかをテストで見るため、出力先へ複製する。 -->
  <ItemGroup>
    <Content Include="../SmarcivaZip.App/Assets/Icons/*.ico" CopyToOutputDirectory="PreserveNewest">
      <TargetPath>Icons/%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- 結合テストは実物の 7z.dll を読み込む。tools/fetch-7zip.ps1 で先に取得しておくこと。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../native/win-x64/7z.dll')">
    <None Include="../../native/win-x64/7z.dll" Link="7z.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SmarcivaZip</AssemblyName>
    <!--
      Windows が「プログラムから開く」やタスクマネージャーに出す名前は
      FileDescription で、これは AssemblyTitle から来る。
      アセンブリ名は大文字始まりの規約に従うので、表示名だけ別に指定する。
    -->
    <AssemblyTitle>smarcivaZIP</AssemblyTitle>
    <RootNamespace>SmarcivaZip.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/smarcivazip.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      自己完結の単一 exe は publish 時にだけ有効にする（tools/build.ps1 を参照）。
      csproj で SelfContained を立ててしまうと、ふだんの dotnet build まで
      RID 付きの出力フォルダに変わって開発が面倒になる。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SmarcivaZip.Core/SmarcivaZip.Core.csproj" />
  </ItemGroup>

  <!--
    exe 自体のアイコン (ApplicationIcon) とは別に、WPF のウィンドウが
    タイトルバーに表示するためのリソースとしても埋め込む。
  -->
  <ItemGroup>
    <Resource Include="Assets/smarcivazip.ico" />
  </ItemGroup>

  <!--
    書庫ファイル用のアイコン。実行ファイルには埋め込まず隣に置く。
    exe に複数のアイコンを入れるには Win32 リソースを自前で用意する必要があり、
    .NET SDK からは素直に扱えない。外に出しておけば利用者が差し替えることもできる。
  -->
  <ItemGroup>
    <Content Include="Assets/Icons/*.ico"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true">
      <TargetPath>Icons/%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!--
    7z.dll は同梱するが、単一 exe には埋め込まず隣に置く。
    LGPL-2.1 の「利用者が差し替えられること」という要件を満たすため。
  -->
  <PropertyGroup>
    <SevenZipArchitecture Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SevenZipArchitecture>
    <SevenZipArchitecture Condition="'$(SevenZipArchitecture)' == ''">win-x64</SevenZipArchitecture>
    <SevenZipSource>$(MSBuildThisFileDirectory)../../native/$(SevenZipArchitecture)/7z.dll</SevenZipSource>
    <SevenZipLicense>$(MSBuildThisFileDirectory)../../native/7-Zip-License.txt</SevenZipLicense>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SevenZipSource)')">
    <None Include="$(SevenZipSource)" Link="7z.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SevenZipLicense)')">
    <None Include="$(SevenZipLicense)" Link="7-Zip-License.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md')">
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>

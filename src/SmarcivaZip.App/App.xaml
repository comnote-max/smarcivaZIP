<Application x:Class="SmarcivaZip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Lhaplus のような「余計なものが無い」見た目を、今風の配色で作る。 -->
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceAlt" Color="#F5F6F8" />
      <SolidColorBrush x:Key="Border" Color="#D8DCE3" />
      <SolidColorBrush x:Key="Text" Color="#1B1F24" />
      <SolidColorBrush x:Key="TextMuted" Color="#5A6472" />
      <!--
        白文字を載せる前提の青。#2C6BED では白とのコントラストが 4.74:1 しかなく、
        WCAG の下限 4.5 をかろうじて超えているだけで、字画の細い日本語では読みにくい。
        アイコンの ZIP 色と同じ #1C5CC4 にして 6.22:1 まで上げてある。
      -->
      <SolidColorBrush x:Key="Accent" Color="#1C5CC4" />
      <SolidColorBrush x:Key="AccentHover" Color="#154A9E" />
      <SolidColorBrush x:Key="Warning" Color="#B7791F" />
      <SolidColorBrush x:Key="Danger" Color="#C0392B" />

      <!--
        書体は並べた順に、その文字を持っているものが使われる。
        Yu Gothic UI には日本語と欧文しか無いので、後ろに各文字体系の書体を足す。
        これが無いと、タイ語やヒンディー語やアラビア語が豆腐になる。
        いずれも Windows 10 以降に標準で入っている。
      -->
      <FontFamily x:Key="UiFont">Yu Gothic UI, Meiryo UI, Segoe UI, Nirmala UI, Leelawadee UI, Segoe UI Historic</FontFamily>

      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style>

      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Shell"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Shell" Property="Background" Value="#EBEEF3" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <!-- 太らせると、地色との差以上に読みやすくなる。漢字や仮名は線が細いため。 -->
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,5" />
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="8,4" />
      </Style>

      <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>

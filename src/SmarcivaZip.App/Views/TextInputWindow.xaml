<Window x:Class="SmarcivaZip.App.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmarcivaZip.App.Localization"
        Title="smarcivaZIP"
        Icon="/Assets/smarcivazip.ico"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource Heading}" />

    <TextBlock x:Name="DetailText" Grid.Row="1" Style="{StaticResource Caption}"
               Margin="0,6,0,0" TextWrapping="Wrap" />

    <TextBox x:Name="InputBox" Grid.Row="2" Margin="0,12,0,0" Padding="8,6"
             BorderBrush="{StaticResource Border}" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:L Common_Cancel}" Click="OnCancelClicked" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="{loc:L Common_OK}" Style="{StaticResource PrimaryButton}" Click="OnOkClicked" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>

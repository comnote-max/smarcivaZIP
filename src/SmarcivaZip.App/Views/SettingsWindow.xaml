<Window x:Class="SmarcivaZip.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmarcivaZip.App.Localization"
        Title="{loc:L Settings_Title}"
        Icon="/Assets/smarcivazip.ico"
        Width="580" Height="660"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16,14,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" BorderBrush="{StaticResource Border}" Background="Transparent">

      <TabItem Header="{loc:L Tab_Setup}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,14">

            <TextBlock Text="{loc:L Setup_LanguageHeading}" Style="{StaticResource Heading}" />
            <ComboBox x:Name="LanguageCombo" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:L Setup_LanguageHelp}" />

            <!-- レジストリに自分で登録する従来の版。ストア版では隠す。 -->
            <StackPanel x:Name="ShellSection">
              <TextBlock Text="{loc:L Setup_ShellHeading}" Style="{StaticResource Heading}"
                         Margin="0,20,0,0" />
              <TextBlock x:Name="RegistrationStateText" Style="{StaticResource Caption}"
                         Margin="0,6,0,0" TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="RegisterButton" Content="{loc:L Setup_Register}" Style="{StaticResource PrimaryButton}"
                        Click="OnRegisterClicked" />
                <Button x:Name="UnregisterButton" Content="{loc:L Setup_Unregister}" Margin="8,0,0,0"
                        Click="OnUnregisterClicked" />
              </StackPanel>

              <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                         Text="{loc:L Setup_Win11Note}" />

              <TextBlock Text="{loc:L Setup_ExtHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="{loc:L Setup_ExtHelp}" />

              <Border Margin="0,8,0,0" Height="184" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="4" Background="{StaticResource Surface}">
                <ListBox x:Name="ExtensionList" BorderThickness="0" Padding="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="2" />
                      <!-- チェックボックスに触れたら、その行も選択状態にする。
                           こうしないと「削除」ボタンがどの項目を指しているか分からない。
                           IsKeyboardFocusWithin のトリガーでやると、削除ボタンへ
                           フォーカスが移った瞬間に選択が外れてしまうので、
                           イベントで明示的に立てる。 -->
                      <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnExtensionItemActivated" />
                      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnExtensionItemActivated" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsSelected}"
                                Margin="2,3,8,3" ToolTip="{Binding Description}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:L Setup_Add}" MinWidth="76" Click="OnAddExtensionClicked" />
                <Button x:Name="RemoveExtensionButton" Content="{loc:L Setup_Remove}" MinWidth="76" Margin="8,0,0,0"
                        Click="OnRemoveExtensionClicked" />
                <Button Content="{loc:L Setup_CheckAll}" MinWidth="88" Margin="8,0,0,0" Click="OnCheckAllClicked" />
                <Button Content="{loc:L Setup_UncheckAll}" MinWidth="88" Margin="8,0,0,0" Click="OnUncheckAllClicked" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:L Setup_AddAllSupported}" MinWidth="240"
                        Click="OnAddAllSupportedClicked" />
                <Button Content="{loc:L Common_ResetDefaults}" MinWidth="96" Margin="8,0,0,0"
                        Click="OnResetExtensionsClicked" />
              </StackPanel>

              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="{loc:L Setup_ExtApplyNote}" />

              <Button Content="{loc:L Setup_OpenDefaultApps}" Margin="0,10,0,0"
                      HorizontalAlignment="Left" MinWidth="220" Click="OnOpenDefaultAppsClicked" />
            </StackPanel>

            <!--
              ストア版（MSIX）。関連付けと右クリックメニューはパッケージの定義で Windows が管理するので、
              ここでは登録も拡張子の選択もできない。どこで変えるのかだけを案内する。
            -->
            <StackPanel x:Name="PackagedShellSection" Visibility="Collapsed">
              <TextBlock Text="{loc:L Setup_ShellHeading}" Style="{StaticResource Heading}"
                         Margin="0,20,0,0" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="{loc:L Setup_PackagedNote}" />
              <Button Content="{loc:L Setup_OpenDefaultApps}" Margin="0,10,0,0"
                      HorizontalAlignment="Left" MinWidth="220" Click="OnOpenDefaultAppsClicked" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:L Tab_Extract}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,14">

            <TextBlock Text="{loc:L Extract_OutputHeading}" Style="{StaticResource Heading}" />
            <RadioButton x:Name="OutputSameFolder" GroupName="Output" Margin="0,8,0,0"
                         Content="{loc:L Extract_OutputSame}" />
            <RadioButton x:Name="OutputFixedFolder" GroupName="Output" Margin="0,6,0,0"
                         Content="{loc:L Extract_OutputFixed}" />
            <Grid Margin="22,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FixedFolderBox" Grid.Column="0" Padding="6,4"
                       BorderBrush="{StaticResource Border}" VerticalContentAlignment="Center" />
              <Button Grid.Column="1" Content="{loc:L Extract_Browse}" Margin="8,0,0,0" MinWidth="72"
                      Click="OnBrowseOutputFolder" />
            </Grid>

            <TextBlock Text="{loc:L Extract_FolderHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <RadioButton x:Name="FolderAuto" GroupName="Folder" Margin="0,8,0,0"
                         Content="{loc:L Extract_FolderAuto}" />
            <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,0" TextWrapping="Wrap"
                       Text="{loc:L Extract_FolderAutoHelp}" />
            <RadioButton x:Name="FolderAlways" GroupName="Folder" Margin="0,8,0,0"
                         Content="{loc:L Extract_FolderAlways}" />
            <RadioButton x:Name="FolderNever" GroupName="Folder" Margin="0,6,0,0"
                         Content="{loc:L Extract_FolderNever}" />

            <TextBlock Text="{loc:L Extract_ConflictHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <RadioButton x:Name="OverwriteRename" GroupName="Overwrite" Margin="0,8,0,0"
                         Content="{loc:L Extract_ConflictRename}" />
            <RadioButton x:Name="OverwriteReplace" GroupName="Overwrite" Margin="0,6,0,0"
                         Content="{loc:L Extract_ConflictOverwrite}" />
            <RadioButton x:Name="OverwriteSkip" GroupName="Overwrite" Margin="0,6,0,0"
                         Content="{loc:L Extract_ConflictSkip}" />

            <TextBlock Text="{loc:L Common_Other}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <CheckBox x:Name="ExcludeMacCheck" Content="{loc:L Extract_ExcludeMac}" />
            <CheckBox x:Name="ExcludeWindowsCheck" Content="{loc:L Extract_ExcludeWindows}" />
            <CheckBox x:Name="TimestampsCheck" Content="{loc:L Extract_Timestamps}" />
            <CheckBox x:Name="MotwCheck" Content="{loc:L Extract_Motw}" />
            <CheckBox x:Name="OpenFolderCheck" Content="{loc:L Extract_OpenFolder}" />
            <CheckBox x:Name="UnwrapTarCheck" Content="{loc:L Extract_UnwrapTar}" />
            <CheckBox x:Name="DeleteArchiveCheck" Content="{loc:L Extract_DeleteArchive}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:L Tab_Compress}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,14">

            <TextBlock Text="{loc:L Compress_DefaultFormatHeading}" Style="{StaticResource Heading}" />
            <ComboBox x:Name="DefaultFormatCombo" Margin="0,8,0,0" />

            <TextBlock Text="{loc:L Compress_LevelHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <ComboBox x:Name="CompressionLevelCombo" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:L Compress_LevelHelp}" />

            <TextBlock Text="{loc:L Compress_MenuHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{loc:L Compress_MenuHelp}" />

            <Border Margin="0,8,0,0" Height="168" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Background="{StaticResource Surface}">
              <ListBox x:Name="MenuFormatList" BorderThickness="0" Padding="6"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2" />
                    <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnMenuFormatItemActivated" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnMenuFormatItemActivated" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="2,3,8,3" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="MenuFormatUpButton" Content="{loc:L Compress_MoveUp}" MinWidth="72"
                      Click="OnMenuFormatMoveUpClicked" />
              <Button x:Name="MenuFormatDownButton" Content="{loc:L Compress_MoveDown}" MinWidth="72" Margin="8,0,0,0"
                      Click="OnMenuFormatMoveDownClicked" />
              <Button Content="{loc:L Common_ResetDefaults}" MinWidth="96" Margin="8,0,0,0"
                      Click="OnResetMenuFormatsClicked" />
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{loc:L Compress_MenuApplyNote}" />

            <TextBlock Text="{loc:L Common_Other}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <CheckBox x:Name="ShowCompressDialogCheck"
                      Content="{loc:L Compress_ShowDialog}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:L Tab_Encoding}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,14">

            <TextBlock Text="{loc:L Encoding_PreferredHeading}" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{loc:L Encoding_PreferredHelp}" />
            <ComboBox x:Name="PreferredCodePageCombo" Margin="0,10,0,0" />

            <TextBlock Text="{loc:L Encoding_PreviewHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <CheckBox x:Name="AlwaysPreviewCheck"
                      Content="{loc:L Encoding_AlwaysPreview}" />
            <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,0" TextWrapping="Wrap"
                       Text="{loc:L Encoding_AlwaysPreviewHelp}" />

            <TextBlock Text="{loc:L Encoding_MacHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <CheckBox x:Name="NormalizeMacCheck"
                      Content="{loc:L Encoding_NormalizeNfd}" />
            <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,0" TextWrapping="Wrap"
                       Text="{loc:L Encoding_NormalizeNfdHelp}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:L Tab_About}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,14">
            <TextBlock Text="smarcivaZIP" Style="{StaticResource Heading}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{loc:L About_Description}" />

            <TextBlock Margin="0,12,0,0">
              <Hyperlink NavigateUri="https://smarciva.com/" RequestNavigate="OnHyperlinkRequestNavigate">
                https://smarciva.com/
              </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,4,0,0">
              <Hyperlink NavigateUri="https://github.com/comnote-max/smarcivaZIP"
                         RequestNavigate="OnHyperlinkRequestNavigate">
                https://github.com/comnote-max/smarcivaZIP
              </Hyperlink>
            </TextBlock>

            <!-- ストア版はストアが更新するので出さない。 -->
            <StackPanel x:Name="UpdateSection">
              <TextBlock Text="{loc:L Update_Heading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
              <CheckBox x:Name="CheckForUpdatesCheck" Content="{loc:L Update_CheckAutomatically}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,0" TextWrapping="Wrap"
                         Text="{loc:L Update_Help}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CheckNowButton" Content="{loc:L Update_CheckNow}" Click="OnCheckForUpdatesClicked" />
                <TextBlock x:Name="UpdateResultText" Style="{StaticResource Caption}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="{loc:L About_EngineHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <TextBlock x:Name="EngineText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{loc:L About_FormatsHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <TextBlock x:Name="FormatsText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{loc:L About_LicenseHeading}" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:L About_License}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{loc:L Common_Cancel}" Click="OnCancelClicked" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="{loc:L Common_Save}" Style="{StaticResource PrimaryButton}"
              Click="OnSaveClicked" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>

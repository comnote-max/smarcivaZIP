<Window x:Class="SmarcivaZip.App.Views.EncodingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmarcivaZip.App.Localization"
        Title="{loc:L Preview_Title}"
        Icon="/Assets/smarcivazip.ico"
        Width="620" Height="520"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="ArchiveNameText" Grid.Row="0" Style="{StaticResource Heading}"
               TextTrimming="CharacterEllipsis" />

    <TextBlock x:Name="VerdictText" Grid.Row="1" Style="{StaticResource Caption}"
               Margin="0,6,0,0" TextWrapping="Wrap" />

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{loc:L Preview_CodePageLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox x:Name="CodePageCombo" Grid.Column="1" SelectionChanged="OnCodePageChanged" />
    </Grid>

    <Border Grid.Row="3" Margin="0,12,0,0" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="4">
      <ListBox x:Name="NameList" BorderThickness="0" Padding="4"
               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Border>

    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <CheckBox x:Name="NormalizeCheck" Click="OnOptionChanged"
                Content="{loc:L Preview_NormalizeNfd}" />
      <CheckBox x:Name="ExcludeMacCheck" Click="OnOptionChanged"
                Content="{loc:L Preview_ExcludeMac}" />
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:L Common_Cancel}" Click="OnCancelClicked" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="ExtractButton" Content="{loc:L Preview_Extract}" Style="{StaticResource PrimaryButton}"
              Click="OnExtractClicked" IsDefault="True" MinWidth="120" />
    </StackPanel>
  </Grid>
</Window>

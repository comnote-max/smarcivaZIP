  <data name="CommandLine_Help" xml:space="preserve">
    <value>smarcivaZIP - program arsip sederhana

Cara pakai:
  SmarcivaZip.exe &lt;arsip&gt;                     ekstrak arsip itu
  SmarcivaZip.exe --extract &lt;arsip&gt;           ekstrak di samping arsip
  SmarcivaZip.exe --extract-to-folder &lt;arsip&gt;
                                              ekstrak ke folder baru
  SmarcivaZip.exe --extract-preview &lt;arsip&gt;
                                              periksa pengodean lalu ekstrak
  SmarcivaZip.exe --compress &lt;format&gt; &lt;jalur...&gt;
                                              arsipkan (format: zip, 7z, tar.gz...)
  SmarcivaZip.exe --compress &lt;format&gt; --password &lt;jalur...&gt;
                                              arsipkan dengan kata sandi
  SmarcivaZip.exe --settings                  buka jendela pengaturan
  SmarcivaZip.exe --register                  daftarkan pengaitan dan menu klik kanan
  SmarcivaZip.exe --unregister                hapus pendaftaran itu</value>
  </data>

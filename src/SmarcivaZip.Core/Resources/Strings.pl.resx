  <data name="CommandLine_Help" xml:space="preserve">
    <value>smarcivaZIP - prosty program do archiwów

Użycie:
  SmarcivaZip.exe &lt;archiwum&gt;                  rozpakuj je
  SmarcivaZip.exe --extract &lt;archiwum&gt;        rozpakuj obok archiwum
  SmarcivaZip.exe --extract-to-folder &lt;archiwum&gt;
                                              rozpakuj do nowego folderu
  SmarcivaZip.exe --extract-preview &lt;archiwum&gt;
                                              sprawdź kodowanie i rozpakuj
  SmarcivaZip.exe --compress &lt;format&gt; &lt;ścieżka...&gt;
                                              spakuj (formaty: zip, 7z, tar.gz...)
  SmarcivaZip.exe --compress &lt;format&gt; --password &lt;ścieżka...&gt;
                                              spakuj z hasłem
  SmarcivaZip.exe --settings                  otwórz okno ustawień
  SmarcivaZip.exe --register                  zarejestruj skojarzenia i menu podręczne
  SmarcivaZip.exe --unregister                usuń rejestrację</value>
  </data>

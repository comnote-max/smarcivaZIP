<Project>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>smarcivaZIP contributors</Authors>
    <Product>smarcivaZIP</Product>
    <Company>smarcivaZIP</Company>
    <Description>Lhaplus の使い心地のまま、RAR5・Zstandard・文字化け対策・macOS 由来の書庫に対応した圧縮解凍ソフト</Description>
    <Copyright>Copyright (c) 2026 smarcivaZIP contributors</Copyright>
    <Version>1.2.1</Version>
    <RepositoryUrl>https://github.com/comnote-max/smarcivaZIP</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
